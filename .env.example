# ============================================================================
# TRACEPOINT CONFIGURATION
# ============================================================================

APP_NAME=TracePoint
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# DATABASE SELECTION: 'oracle' or 'sqlite'
# If ORACLE_USER and ORACLE_DSN are provided, TracePoint will connect to Oracle Database Free / 19c / 21c / 23ai.
# If Oracle is unreachable or not configured, it transparently falls back to local SQLite with clear telemetry.
DB_ENGINE=sqlite

# ORACLE DATABASE CREDENTIALS (Placeholder - do not commit real secrets)
ORACLE_USER=tracepoint_app
ORACLE_PASSWORD=change_this_password
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_WALLET_DIR=
ORACLE_CONFIG_DIR=

# SQLITE FALLBACK PATH
SQLITE_DB_PATH=tracepoint.db
